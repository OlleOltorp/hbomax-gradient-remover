{
  "manifest_version": 3,
  "name": "Gradient Remover for HBO Max",
  "version": "1.0.0",
  "description": "Hides the dark gradient overlays above and below the HBO Max video player.",
  "browser_specific_settings": {
    "gecko": {
      "id": "hbomax-gradient@olleoltorp.dev",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.hbomax.com/*"],
      "css": ["hide-gradient.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}

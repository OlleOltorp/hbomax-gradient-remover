{
  "manifest_version": 3,
  "name": "Gradient Remover for HBO Max",
  "version": "1.1.1",
  "description": "Hides the dark gradient overlays above and below the HBO Max video player.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.hbomax.com/*"],
      "css": ["hide-gradient.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
